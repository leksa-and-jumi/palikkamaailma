{
  "name": "palikkamaailma",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Block world for building together / Palikkamaailma, jossa rakennetaan yhdessä",
  "scripts": {
    "dev": "vite",
    "dev:room": "wrangler dev --port 8788",
    "convex:dev": "node scripts/convex.mjs dev",
    "convex:deploy": "node scripts/convex.mjs deploy",
    "room:deploy": "node scripts/wrangler.mjs deploy",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fontsource-variable/nunito": "5.3.0",
    "@fontsource/pixelify-sans": "5.3.0",
    "convex": "^1.47.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261022.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.3"
  }
}
