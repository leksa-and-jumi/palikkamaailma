// Cloudflare Worker + Durable Objects for the multiplayer rooms.
// Local:  npm run dev:room    Deploy: npm run room:deploy
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "palikkamaailma-huoneet",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [{ "name": "WORLD_ROOM", "class_name": "WorldRoom" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["WorldRoom"] }],
  "vars": {
    "ALLOWED_ORIGINS": "https://leksa-and-jumi.github.io,http://localhost:5178,http://127.0.0.1:5178",
    // Production Convex HTTP actions (local dev overrides this in .dev.vars).
    "CONVEX_SITE_URL": "https://notable-possum-532.eu-west-1.convex.site",
  },
}
