# Copy to .env.local and fill in. Never commit .env.local!
# Kopioi tiedostoon .env.local ja täytä. Älä koskaan commitoi .env.localia!

# --- Convex (maailmalista + taikarakentaja) ---
# Convex dashboard → dev deployment → Settings → Deploy keys → "Generate development deploy key"
CONVEX_DEPLOY_KEY_DEV=dev:TAYTA_TAHAN
# Convex dashboard → production deployment → Settings → Deploy keys → "Generate production deploy key"
CONVEX_DEPLOY_KEY_PROD=prod:TAYTA_TAHAN
# Dev deployment URL, e.g. https://happy-otter-123.convex.cloud
# Leave empty to play without Convex (world codes are then not checked).
VITE_CONVEX_URL=

# --- Cloudflare (moninpelihuoneet, Durable Objects) ---
# dash.cloudflare.com → My Profile → API Tokens → "Edit Cloudflare Workers" template
CLOUDFLARE_API_TOKEN=TAYTA_TAHAN
# dash.cloudflare.com → Workers & Pages → Account ID (right side)
CLOUDFLARE_ACCOUNT_ID=TAYTA_TAHAN
# Room server URL. Local: http://localhost:8788 (npm run dev:room).
# Leave empty to play alone (no multiplayer).
VITE_ROOM_URL=http://localhost:8788

# --- OpenRouter (taikarakentajan tekoäly) ---
# openrouter.ai → Settings → API Keys → Create key (set a credit limit!)
# This key lives only on the server: `npx convex env set OPENROUTER_API_KEY ...`
OPENROUTER_API_KEY=TAYTA_TAHAN
